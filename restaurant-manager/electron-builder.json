{
  "appId": "com.example.restaurantmanager",
  "productName": "مدیر رستوران",
  "directories": { "output": "release" },
  "files": ["dist/**/*", "electron/**/*"],
  "win": {
    "target": [{ "target": "nsis", "arch": ["x64"] }],
